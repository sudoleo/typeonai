FIREBASE_API_KEY=XXXX
FIREBASE_AUTH_DOMAIN=dein-projekt.firebaseapp.com
FIREBASE_PROJECT_ID=dein-projekt
FIREBASE_STORAGE_BUCKET=dein-projekt.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Canonical public origin for links generated by routers and background jobs.
# Only an absolute http(s) origin without path/query/fragment is accepted.
PUBLIC_SITE_URL=https://www.consens.io

# Single server-side key used for every LLM provider through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional, admin-triggered read-only SEO content judge. It reuses the server
# OpenRouter key above and remains disabled unless a model is explicitly set.
SEO_CONTENT_JUDGE_MODEL=

# Single-call weekly SEO portfolio judge. Defaults to GPT-5.6 Terra when empty;
# both SEO judges use the same server OpenRouter key above.
SEO_PORTFOLIO_JUDGE_MODEL=gpt-5.6-terra

# Shared Telegram bot. CHAT_ID is the admin destination for SEO/Publisher
# alerts. USERNAME + WEBHOOK_SECRET additionally enable per-user Watch alerts;
# username has no @, webhook secret uses Telegram's A-Z/a-z/0-9/_/- charset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional separate destination for critical app/server failures. Falls back
# to TELEGRAM_CHAT_ID when empty.
CRITICAL_ERROR_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SEO_ADMIN_URL=https://www.consens.io/admin#seo

# Consensus Watch e-mail delivery and signed one-click unsubscribe links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
WATCH_UNSUBSCRIBE_SECRET=
# HMAC-signs owner-bound opaque /chats pagination cursors. If unset, the
# existing WATCH_UNSUBSCRIBE_SECRET is used as a backwards-compatible fallback.
CHAT_CURSOR_SECRET=

# Google Search Console (read-only Search Analytics). Despite the variable
# name, this value is always a service-account JSON file path. Relative paths
# resolve from the repository root; Render may use /etc/secrets/....
GSC_SITE_URL=sc-domain:consens.io
# Path to the service account file, not its contents. GSC_SERVICE_ACCOUNT_FILE
# is accepted under the same rules.
GSC_SERVICE_ACCOUNT_JSON=gen-lang-client-0234219247-e1d621f936a2.json

# Central provider transport budgets. OpenAI-compatible SDK retries are always
# disabled; explicit schema/fallback retries stay in the engine layer.
PROVIDER_CONNECT_TIMEOUT_SECONDS=10
PROVIDER_READ_TIMEOUT_SECONDS=120

# Periodic pending/revoked-share cleanup, independent of process restarts.
RETENTION_MAINTENANCE_INTERVAL_SECONDS=3600

# Worker threads for the synchronous SSE endpoints. Every in-flight provider
# stream holds one thread for up to PROVIDER_READ_TIMEOUT_SECONDS, and one run
# fans out to six providers -- anyio's default of 40 saturated at ~6 concurrent
# users. Allowed range: 40..512.
MAX_WORKER_THREADS=160

# Full HTTP request-body cap before FastAPI parses JSON/forms (default 16 MiB).
# Allowed deployment range: 1024..33554432 bytes.
MAX_REQUEST_BODY_BYTES=16777216

# Test-only E2E profile. Keep disabled in normal .env/Render configuration;
# tests/e2e/conftest.py sets the complete guarded emulator environment.
E2E_TEST_MODE=0
# Set automatically by tests/conftest.py; never enable on an app server.
UNIT_TEST_MODE=0
